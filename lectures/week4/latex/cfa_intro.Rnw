%----------------------------------------------------------------------------------------------------------------------%

\sectionslide{General Ideas}

%----------------------------------------------------------------------------------------------------------------------%

\subsection{Working Definitions}

%----------------------------------------------------------------------------------------------------------------------%

\begin{frame}{Latent Variables}

  A \emph{latent variable} is simply an unobservable variable
  \begin{itemize}
    \item Usually something we want to analyze
    \item The mathematical formalization of a \emph{Hypothetical Construct}
  \end{itemize}

  \va

  Latent variables are very common.

  \begin{itemize}
    \item A patient's current mood
    \item The approval rate of a political leader
    \item The health of an ecosystem
    \item The number of "calories" burned by an hour of cardio training
    \item The useful lifespan of an industrial machine
  \end{itemize}

\end{frame}

%----------------------------------------------------------------------------------------------------------------------%

\begin{frame}{Factor Analysis}

  \emph{Factor analysis} (FA) is a statistical method for estimating latent variables.

  \begin{itemize}
    \item We estimate a set of latent variables that parsimoniously explain the relations among a pool of observed
      variables.
    \item Factor analyses can be exploratory (\emph{Exploratory Factor Analysis}, EFA) or confirmatory
      (\emph{Confirmatory Factor Analysis}, CFA).
  \end{itemize}

  \va

  In FA, we are primarily interested in estimating the underlying \emph{measurement model}.

  \begin{itemize}
    \item The latent structure through which a set of latent variables generate a set of observed items.
    \item Hence, principal components analysis (PCA) is not true FA.
  \end{itemize}

\end{frame}

%----------------------------------------------------------------------------------------------------------------------%

\begin{frame}{Latent Factors}

  A \emph{latent factor} or \emph{latent construct} is the specific type of latent variable that we're estimating in FA.

  \begin{itemize}
    \item To estimate a latent factor, we need multiple, substantively overlapping \emph{indicator variables}.
    \item All latent factors are latent variables, but not all latent variables are latent factors.
  \end{itemize}
  
  \va

  Latent factors are very common in social and behavior science because we often use multi-item questionnaire to measure
  the various unobservable aspects of society and human experience.

  \begin{itemize}
    \item Mental health screeners (e.g., Beck Depression Inventory, Child Behavior Checklist)
    \item Intelligence tests (e.g., WAIS, WISC)
    \item Customer satisfaction surveys
  \end{itemize}

\end{frame}

%----------------------------------------------------------------------------------------------------------------------%

\begin{frame}{Indicator Variables}

  The \emph{indicator variables} are the observed variables that we use to estimate a latent factor.
  
  \begin{itemize}
    \item The latent factor is never observed, so we need to infer its characteristics from the information provided by
      our observed data.
    \item A \emph{measurement model} is a one-to-many mapping of latent factors onto indicator variables.
  \end{itemize}

  \va

  Indicator variables go by many names
  
  \begin{itemize}
    \item Indicators
    \item Observed variables
    \item Observed items
    \item Pretty much any sensible combination of the words: \emph{observed}, \emph{variable}, \emph{item},
      \emph{indicator}
  \end{itemize}

\end{frame}

%----------------------------------------------------------------------------------------------------------------------%

